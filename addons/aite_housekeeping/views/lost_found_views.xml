<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lost_found_list" model="ir.ui.view">
        <field name="name">aite.hk.lost.found.list</field>
        <field name="model">aite.hk.lost.found</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'returned'" decoration-muted="state == 'disposed'">
                <field name="found_date"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="place" optional="show"/>
                <field name="partner_id"/>
                <field name="storage" optional="show"/>
                <field name="found_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'stored'"
                       decoration-success="state == 'returned'"/>
                <field name="returned_date" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_lost_found_form" model="ir.ui.view">
        <field name="name">aite.hk.lost.found.form</field>
        <field name="model">aite.hk.lost.found</field>
        <field name="arch" type="xml">
            <form string="Objet trouvé">
                <header>
                    <button name="action_return" type="object" string="Rendu au client"
                            class="btn-primary" invisible="state != 'stored'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. : téléphone noir, montre, chargeur…"/></h1>
                    </div>
                    <group>
                        <group string="Où et quand">
                            <field name="found_date"/>
                            <field name="room_id"/>
                            <field name="place"/>
                            <field name="found_by"/>
                            <field name="storage"/>
                        </group>
                        <group string="À qui">
                            <field name="reservation_id"/>
                            <field name="partner_id"/>
                            <field name="returned_date" invisible="state == 'stored'"/>
                            <field name="returned_to" invisible="state == 'stored'"/>
                        </group>
                    </group>
                    <group>
                        <field name="image" widget="image" options="{'size': [240, 180]}"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_lost_found_search" model="ir.ui.view">
        <field name="name">aite.hk.lost.found.search</field>
        <field name="model">aite.hk.lost.found</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <field name="partner_id"/>
                <filter name="stored" string="Conservés" domain="[('state', '=', 'stored')]"/>
                <filter name="returned" string="Rendus" domain="[('state', '=', 'returned')]"/>
            </search>
        </field>
    </record>
    <record id="action_lost_found" model="ir.actions.act_window">
        <field name="name">Objets trouvés</field>
        <field name="res_model">aite.hk.lost.found</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_stored': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun objet trouvé</p>
            <p>Notez ici tout objet oublié par un client : quoi, dans quelle
               chambre, où il est rangé. Le séjour est retrouvé automatiquement
               pour prévenir le client.</p>
        </field>
    </record>
</odoo>
