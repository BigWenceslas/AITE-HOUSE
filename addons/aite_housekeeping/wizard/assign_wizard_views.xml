<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_wizard_form" model="ir.ui.view">
        <field name="name">aite.hk.assign.wizard.form</field>
        <field name="model">aite.hk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Répartir les chambres du jour">
                <p class="text-muted">Cochez les équipières présentes : les chambres
                   à faire sont distribuées à tour de rôle, étage par étage.</p>
                <group>
                    <field name="hotel_id" options="{'no_create': True}"/>
                    <field name="date"/>
                    <field name="user_ids" widget="many2many_checkboxes"/>
                    <field name="reassign"/>
                    <field name="task_count"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Répartir"
                            class="btn-primary" icon="fa-random"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_assign_wizard" model="ir.actions.act_window">
        <field name="name">Répartir les chambres du jour</field>
        <field name="res_model">aite.hk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
