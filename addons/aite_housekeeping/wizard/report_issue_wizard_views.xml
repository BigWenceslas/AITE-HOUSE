<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_issue_wizard_form" model="ir.ui.view">
        <field name="name">aite.hk.report.issue.wizard.form</field>
        <field name="model">aite.hk.report.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Signaler un problème">
                <group>
                    <field name="room_id" readonly="1"/>
                    <field name="name" placeholder="Ex. : climatiseur en panne, fuite lavabo…"/>
                    <field name="priority" widget="priority"/>
                    <field name="blocks_room"/>
                    <field name="description" placeholder="Précisions utiles au technicien"/>
                    <field name="image" widget="image" options="{'size': [200, 150]}"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Envoyer à la maintenance"
                            class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
