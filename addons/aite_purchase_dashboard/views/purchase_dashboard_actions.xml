<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_aite_purchase_dashboard" model="ir.actions.client">
        <field name="name">Achats &amp; Fournisseurs — Tableau de bord</field>
        <field name="tag">aite_purchase_dashboard</field>
    </record>

    <record id="action_aite_purchase_deposit" model="ir.actions.act_window">
        <field name="name">Consignes fournisseurs</field>
        <field name="res_model">aite.purchase.deposit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Suivez vos casiers consignés chez chaque fournisseur.
            </p>
            <p>Une ligne par fournisseur : nombre de casiers, valeur de
            consigne unitaire — la valeur immobilisée alimente le tableau
            de bord Achats (créances 409).</p>
        </field>
    </record>

</odoo>
