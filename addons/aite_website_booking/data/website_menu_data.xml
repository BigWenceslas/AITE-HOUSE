        <record id="menu_website_reservation" model="website.menu">
            <field name="name">Réservation</field>
            <field name="url">/reservation</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
