<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="aite_exec_dashboard.KpiCard">
        <div t-att-class="'aed-kpi ' + (props.mega ? 'aed-kpi-mega aed-accent-' + props.accent : '')"
             t-att-title="props.hint || undefined">
            <div class="aed-kpi-label">
                <t t-esc="props.label"/>
                <span t-if="props.hint" class="aed-kpi-help" t-att-title="props.hint"
                      role="img" aria-label="Explication">?</span>
            </div>
            <div class="aed-kpi-value" t-esc="props.value"/>
            <div t-if="hasDelta" t-att-class="'aed-kpi-delta ' + deltaCls" t-esc="deltaText"/>
            <div t-if="props.sub" class="aed-kpi-sub" t-esc="props.sub"/>
        </div>
    </t>

    <t t-name="aite_exec_dashboard.Dashboard">
        <div class="aed-dashboard-root o_action">
            <ExecDashboardView/>
        </div>
    </t>

    <t t-name="aite_exec_dashboard.DashboardView">
        <div class="aed-dashboard">

            <div class="aed-topbar">
                <div>
                    <h2 class="aed-title">Direction — Activité par pôle</h2>
                    <div class="aed-sub">Hébergement · Restauration &amp; boutique · Prestations</div>
                </div>
            </div>

            <div class="aed-filterbar">
                <div class="aed-filterrow">
                    <span class="aed-flabel">Période</span>
                    <t t-foreach="periodPresets" t-as="p" t-key="p.key">
                        <button t-att-class="'aed-chip ' + (state.period === p.key ? 'active' : '')"
                                t-on-click="() => this.setPeriod(p.key)" t-esc="p.label"/>
                    </t>
                    <span class="aed-spacer"/>
                    <span class="aed-flabel">Du</span>
                    <input type="date" class="aed-date" t-att-value="state.dateFrom"
                           t-on-change="(ev) => this.onFromInput(ev)"/>
                    <span class="aed-flabel">au</span>
                    <input type="date" class="aed-date" t-att-value="state.dateTo"
                           t-on-change="(ev) => this.onToInput(ev)"/>
                </div>
            </div>

            <div t-if="state.loading" class="aed-loading">
                <i class="fa fa-spinner fa-spin"/> Chargement…
            </div>

            <div t-else="">

                <div class="aed-grid aed-grid-4">
                    <KpiCard mega="true" accent="'primary'"
                             label="'Chiffre d\'affaires total'"
                             value="money(state.kpis.total_ca)"
                             sub="periodText"/>
                    <KpiCard mega="true" accent="'primary'"
                             label="'Hébergement'"
                             value="money(state.kpis.hotel_ca)"
                             sub="'Nuitées HT, nuit par nuit · occupation ' + pct(state.kpis.occupancy) + ' · prix moyen ' + money(state.kpis.adr) + ' / nuit'"/>
                    <KpiCard mega="true" accent="'info'"
                             label="'Restauration &amp; boutique'"
                             value="money(state.kpis.pos_ca)"
                             sub="'HT · ' + num(state.kpis.tickets) + ' tickets · panier ' + money(state.kpis.basket)"/>
                    <KpiCard mega="true" accent="'teal'"
                             label="'Prestations'"
                             value="money(state.kpis.slots_ca)"
                             sub="num(state.kpis.slots_count) + ' prestation(s) réalisée(s)'"/>
                </div>

                <div class="aed-section-title">Hébergement — indicateurs de performance
                    <span class="aed-section-hint" t-att-title="hint('last_year')">écarts vs même période N-1</span>
                </div>
                <div class="aed-grid aed-grid-5">
                    <KpiCard label="'Taux d\'occupation'"
                             value="pct(state.kpis.occupancy)"
                             hint="hint('occupancy')"
                             delta="state.kpis.deltas_ly.occupancy"
                             sub="num(state.kpis.nights_sold) + ' nuitée(s) vendue(s)'"/>
                    <KpiCard label="'Prix moyen par nuit (ADR)'"
                             value="money(state.kpis.adr)"
                             hint="hint('adr')"
                             delta="state.kpis.deltas_ly.adr"
                             sub="'CA hébergement ÷ nuitées vendues'"/>
                    <KpiCard label="'Revenu par chambre disponible (RevPAR)'"
                             value="money(state.kpis.revpar)"
                             hint="hint('revpar')"
                             delta="state.kpis.deltas_ly.revpar"
                             sub="'par chambre disponible, vendue ou non'"/>
                    <KpiCard label="'Réservations récentes (pickup)'"
                             value="num(state.kpis.pickup.nights) + ' nuitée(s)'"
                             hint="hint('pickup')"
                             sub="pickupSub"/>
                    <KpiCard label="'Rythme du mois (pace)'"
                             value="num(state.kpis.pace.nights) + ' nuitée(s)'"
                             hint="hint('pace')"
                             delta="state.kpis.pace.delta"
                             deltaLabel="'vs même date N-1'"
                             sub="paceSub"/>
                </div>

                <div class="aed-grid aed-grid-4" t-if="state.meta.has_loyalty">
                    <KpiCard label="'Points fidélité émis'"
                             value="num(state.kpis.points_issued)"
                             sub="'Tous services confondus'"/>
                </div>

                <div class="aed-section-title">Répartition &amp; évolution</div>
                <div class="aed-grid aed-grid-2">
                    <div class="aed-card">
                        <h3>Mix du chiffre d'affaires par pôle</h3>
                        <div class="aed-chartbox"><canvas t-ref="mixChart"/></div>
                        <div class="aed-mixlist">
                            <t t-foreach="state.kpis.mix" t-as="row" t-key="row.key">
                                <div class="aed-mixrow">
                                    <span class="aed-dot" t-att-style="dotStyle(row.key)"/>
                                    <span class="aed-mixlabel" t-esc="poleLabel(row.key)"/>
                                    <span class="aed-mixval" t-esc="mixLine(row)"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="aed-card">
                        <h3>Évolution mensuelle — 6 mois</h3>
                        <div class="aed-chartbox aed-chartbox-tall"><canvas t-ref="evoChart"/></div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
