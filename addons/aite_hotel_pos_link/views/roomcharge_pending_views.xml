<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_roomcharge_pending_list" model="ir.ui.view">
        <field name="name">aite.roomcharge.pending.list</field>
        <field name="model">aite.roomcharge.pending</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'todo'"
                  decoration-success="state == 'done'" create="false">
                <!-- Libellé explicite : le champ technique create_date
                     s'affichait « Created on » (module sans traduction). -->
                <field name="create_date" widget="datetime" string="Reçue le"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="note"/>
                <field name="folio_id"
                       context="{'aite_folio_with_partner': True}"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'todo'"
                       decoration-success="state == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_roomcharge_pending_form" model="ir.ui.view">
        <field name="name">aite.roomcharge.pending.form</field>
        <field name="model">aite.roomcharge.pending</field>
        <field name="arch" type="xml">
            <!-- create="0" : une note en attente naît d'un ticket de caisse,
                 jamais d'une saisie (la liste l'interdisait déjà). -->
            <form string="Note de chambre en attente" create="0">
                <header>
                    <button name="action_resolve" type="object"
                            string="Rattacher au folio" class="btn-primary"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="note" readonly="1"/>
                        </group>
                        <group>
                            <!-- Folios proposés : séjours commencés
                                 (arrivé, ou parti sans facture), ceux du
                                 client du ticket d'abord ; référence suivie
                                 du nom du client. -->
                            <field name="folio_candidate_ids" invisible="1"/>
                            <field name="folio_id"
                                   readonly="state == 'done'"
                                   domain="[('id', 'in', folio_candidate_ids)]"
                                   context="{'aite_folio_with_partner': True}"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_roomcharge_pending" model="ir.actions.act_window">
        <field name="name">Notes de chambre en attente</field>
        <field name="res_model">aite.roomcharge.pending</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Rien à rattacher</p>
            <p>Quand le bar encaisse en « Note de chambre » sans pouvoir
            trouver le séjour (client non identifié, aucun ou plusieurs
            folios ouverts), le ticket arrive ici. Ouvrez-le, choisissez le
            folio du client dans « Folio choisi » puis cliquez sur
            « Rattacher au folio » : la consommation s'ajoute à sa note.</p>
        </field>
    </record>
    <record id="view_roomcharge_pending_search" model="ir.ui.view">
        <field name="name">aite.roomcharge.pending.search</field>
        <field name="model">aite.roomcharge.pending</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="todo" string="À rattacher" domain="[('state','=','todo')]"/>
                <filter name="done" string="Rattachées" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>
</odoo>
