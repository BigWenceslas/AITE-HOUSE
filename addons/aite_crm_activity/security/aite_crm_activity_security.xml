<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Rapport d'analyse des activités : une vue SQL ne passe pas par les
         contrôles propres à mail.activity. Ces règles reprennent celles des
         opportunités (crm/security/crm_security.xml) :
         - société : seulement les opportunités des sociétés actives ;
         - commercial (mes documents) : ses activités, celles de ses
           opportunités et celles des opportunités sans commercial, comme
           dans la liste des activités d'Odoo ;
         - tous les documents : tout. -->
    <data noupdate="1">

        <record id="aite_crm_activity_report_rule_multi_company" model="ir.rule">
            <field name="name">Analyse des activités CRM : multi-société</field>
            <field name="model_id" ref="model_aite_crm_activity_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="aite_crm_activity_report_rule_personal" model="ir.rule">
            <field name="name">Analyse des activités CRM : mes activités et mes opportunités</field>
            <field name="model_id" ref="model_aite_crm_activity_report"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('lead_user_id', '=', user.id), ('lead_user_id', '=', False)]</field>
            <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="aite_crm_activity_report_rule_all" model="ir.rule">
            <field name="name">Analyse des activités CRM : toutes les activités</field>
            <field name="model_id" ref="model_aite_crm_activity_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

    </data>

</odoo>
