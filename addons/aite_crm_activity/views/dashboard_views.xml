<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tableau de bord : action client (composant OWL
         « aite_crm_activity_dashboard », static/src/dashboard). -->
    <record id="action_crm_activity_dashboard" model="ir.actions.client">
        <field name="name">Suivi des activités</field>
        <field name="tag">aite_crm_activity_dashboard</field>
        <field name="path">suivi-activites</field>
    </record>

    <!-- Lien direct vers « mes activités en retard » (bouton du
         récapitulatif du matin) : même tableau de bord, filtre « En retard »
         pré-sélectionné ; pas de menu. -->
    <record id="action_crm_activity_dashboard_overdue" model="ir.actions.client">
        <field name="name">Activités en retard</field>
        <field name="tag">aite_crm_activity_dashboard</field>
        <field name="path">activites-en-retard</field>
        <field name="params" eval="{'bucket': 'overdue'}"/>
    </record>

    <!-- Menu de premier niveau du CRM, juste après « Ventes ». -->
    <menuitem id="menu_crm_activity_dashboard"
              name="Suivi des activités"
              parent="crm.crm_menu_root"
              action="action_crm_activity_dashboard"
              sequence="2"
              groups="sales_team.group_sale_salesman"/>

</odoo>
