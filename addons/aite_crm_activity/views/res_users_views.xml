<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- « Mes préférences » (menu de l'avatar) : chacun choisit de recevoir
         ou non le récapitulatif du matin. -->
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.aite.crm.activity</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="aite_crm_digest_subscribed" readonly="0"
                       groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <!-- Fiche utilisateur (administrateurs). -->
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.inherit.aite.crm.activity</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']" position="inside">
                <field name="aite_crm_digest_subscribed" invisible="share"/>
            </xpath>
        </field>
    </record>

</odoo>
