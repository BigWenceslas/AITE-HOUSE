<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Section du récapitulatif : un tableau d'activités. -->
    <template id="digest_email_section">
        <t t-if="rows">
            <tr>
                <td style="padding: 20px 0 8px 0;">
                    <span t-attf-style="display: inline-block; width: 10px; height: 10px; border-radius: 5px; background-color: #{color}; margin-right: 6px;"></span>
                    <strong style="font-size: 15px; color: #1F2A30;" t-out="title"/>
                    <span style="color: #6C757D;"> (<t t-out="count"/>)</span>
                </td>
            </tr>
            <tr>
                <td>
                    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; font-size: 13px;">
                        <tr style="background-color: #F3F4F6; color: #4B5563; text-align: left;">
                            <th style="padding: 6px 8px; font-weight: 600;">Échéance</th>
                            <th style="padding: 6px 8px; font-weight: 600;">Activité</th>
                            <th style="padding: 6px 8px; font-weight: 600;">Opportunité</th>
                            <th style="padding: 6px 8px; font-weight: 600; text-align: right;">Montant</th>
                        </tr>
                        <tr t-foreach="rows" t-as="row" style="border-bottom: 1px solid #E5E7EB;">
                            <td style="padding: 8px; white-space: nowrap; vertical-align: top;">
                                <t t-out="row['deadline']"/>
                                <div t-if="row['late_days']" style="color: #B42318; font-size: 12px;">
                                    <t t-out="row['late_days']"/> j de retard
                                </div>
                            </td>
                            <td style="padding: 8px; vertical-align: top;">
                                <strong t-out="row['type']"/>
                                <div t-if="row['summary']" style="color: #4B5563;" t-out="row['summary']"/>
                            </td>
                            <td style="padding: 8px; vertical-align: top;">
                                <a t-if="row['url']" t-att-href="row['url']" style="color: #714B67; text-decoration: none; font-weight: 600;" t-out="row['lead_name']"/>
                                <strong t-else="" style="color: #1F2A30;" t-out="row['lead_name']"/>
                                <div style="color: #6C757D; font-size: 12px;">
                                    <t t-out="row['partner']"/><t t-if="row['partner'] and row['stage']"> · </t><t t-out="row['stage']"/>
                                </div>
                            </td>
                            <td style="padding: 8px; vertical-align: top; text-align: right; white-space: nowrap;" t-out="row['revenue']"/>
                        </tr>
                    </table>
                    <div t-if="count &gt; max_rows" style="color: #6C757D; font-size: 12px; padding-top: 6px;">
                        … et <t t-out="count - max_rows"/> autre(s)<t t-if="can_open_dashboard"> : voir le tableau de bord</t>.
                    </div>
                </td>
            </tr>
        </t>
    </template>

    <!-- E-mail complet du récapitulatif du matin (mis en forme pour les
         clients de messagerie : tableaux, styles en ligne). -->
    <template id="digest_email">
        <div style="margin: 0; padding: 0; background-color: #F6F7F9; font-family: Arial, Helvetica, sans-serif; color: #1F2A30;">
            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #F6F7F9; padding: 24px 0;">
                <tr>
                    <td align="center">
                        <table width="640" cellpadding="0" cellspacing="0" style="max-width: 640px; width: 100%; background-color: #FFFFFF; border-radius: 8px; padding: 24px;">
                            <tr>
                                <td>
                                    <div style="font-size: 12px; color: #6C757D; text-transform: uppercase; letter-spacing: 0.04em;" t-out="company.name"/>
                                    <h1 style="font-size: 20px; margin: 4px 0 4px 0; color: #1F2A30;">Vos activités CRM du jour</h1>
                                    <div style="color: #6C757D; font-size: 13px;" t-out="today"/>
                                    <p style="font-size: 14px; margin: 16px 0 0 0;">
                                        Bonjour <t t-out="user.name"/>,<br/>
                                        voici vos activités en cours sur les opportunités :
                                        <strong style="color: #B42318;"><t t-out="counts['overdue']"/> en retard</strong>,
                                        <strong style="color: #B54708;"><t t-out="counts['today']"/> pour aujourd'hui</strong>
                                        <t t-if="upcoming_days">et <strong><t t-out="counts['upcoming']"/> à venir</strong>
                                            sur les <t t-out="upcoming_days"/> prochains jours</t>.
                                    </p>
                                </td>
                            </tr>
                            <t t-call="aite_crm_activity.digest_email_section">
                                <t t-set="rows" t-value="sections['overdue']"/>
                                <t t-set="count" t-value="counts['overdue']"/>
                                <t t-set="color" t-value="'#D92D20'"/>
                                <t t-set="title">En retard</t>
                            </t>
                            <t t-call="aite_crm_activity.digest_email_section">
                                <t t-set="rows" t-value="sections['today']"/>
                                <t t-set="count" t-value="counts['today']"/>
                                <t t-set="color" t-value="'#F79009'"/>
                                <t t-set="title">Aujourd'hui</t>
                            </t>
                            <t t-call="aite_crm_activity.digest_email_section">
                                <t t-set="rows" t-value="sections['upcoming']"/>
                                <t t-set="count" t-value="counts['upcoming']"/>
                                <t t-set="color" t-value="'#2E90FA'"/>
                                <t t-set="title">À venir</t>
                            </t>
                            <tr t-if="can_open_dashboard">
                                <td style="padding-top: 24px;">
                                    <a t-att-href="dashboard_url"
                                       style="display: inline-block; background-color: #714B67; color: #FFFFFF; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; font-size: 14px;">
                                        Ouvrir mon suivi des activités
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-top: 24px; color: #9CA3AF; font-size: 12px;">
                                    Vous recevez ce récapitulatif chaque matin. Pour ne plus le recevoir :
                                    votre avatar → Mes préférences → « Récapitulatif CRM du matin ».
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </template>

</odoo>
