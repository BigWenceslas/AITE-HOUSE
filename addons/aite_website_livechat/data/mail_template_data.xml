<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Réponse par e-mail au visiteur qui a quitté le site.

             Préparé par le module quand un opérateur écrit dans une
             conversation du chat alors que le visiteur n'est plus connecté,
             et seulement vers l'adresse que le visiteur a donnée (ou celle de
             son compte). Destinataire, date d'envoi et regroupement des
             réponses (un e-mail au plus toutes les 10 minutes) sont gérés
             par le module : seuls le sujet, l'expéditeur, l'adresse de
             réponse et le texte se règlent ici.

             object.aite_email_reply_html : les réponses des opérateurs depuis
             le dernier e-mail, en texte échappé (aucune mise en forme ni
             contenu d'une autre conversation). -->
        <record id="mail_template_livechat_email_reply" model="mail.template">
            <field name="name">Chat du site : réponse au visiteur par e-mail</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="subject">{{ object.aite_email_website_id.company_id.name }} a répondu à votre message</field>
            <field name="email_from">{{ (object.aite_email_website_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="reply_to">{{ (object.aite_email_website_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="description">Envoyé au visiteur du chat du site, quand un opérateur lui répond après son départ</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Verdana, Arial, sans-serif; font-size: 14px; color: #454748;">
    <t t-set="website" t-value="object.aite_email_website_id"/>
    <t t-set="company" t-value="website.company_id or user.company_id"/>
    <t t-set="website_url" t-value="website.get_base_url() if website else object.get_base_url()"/>
    <p style="margin: 0px 0px 12px 0px;">Bonjour,</p>
    <p style="margin: 0px 0px 12px 0px;">
        Vous nous avez écrit sur le chat du site <t t-out="website.name or company.name or ''">Mon site</t>. Voici notre réponse :
    </p>
    <div style="margin: 0px 0px 16px 0px; padding: 2px 16px 12px 16px; border-left: 3px solid #875A7B; background-color: #F7F7F9;">
        <t t-out="object.aite_email_reply_html or ''">Bonjour, merci pour votre question.</t>
    </div>
    <p style="margin: 0px 0px 16px 0px;">
        Pour poursuivre la discussion, revenez sur notre site : la conversation reprend dans le chat, depuis le même navigateur.
    </p>
    <div style="margin: 16px 0px 16px 0px;">
        <a t-att-href="website_url"
           t-attf-style="background-color: {{ company.email_secondary_color or '#875A7B' }}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{ company.email_primary_color or '#FFFFFF' }}; border-radius: 5px; font-size: 13px;">
            Reprendre la conversation
        </a>
    </div>
    <p style="margin: 0px;">
        Cordialement,<br/>
        L'équipe <t t-out="company.name or ''">AITE Consulting</t>
    </p>
    <p style="margin: 16px 0px 0px 0px; font-size: 12px; color: #8A8A8A;">
        Vous recevez cet e-mail parce que vous nous avez écrit sur le chat de notre site.
    </p>
</div>
            </field>
        </record>

    </data>
</odoo>
