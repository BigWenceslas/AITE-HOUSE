<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_daily_report_pivot" model="ir.ui.view">
        <field name="name">aite.pos.daily.report.pivot</field>
        <field name="model">aite.pos.daily.report</field>
        <field name="arch" type="xml">
            <pivot string="Analyse POS" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="categ_id" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_daily_report_graph" model="ir.ui.view">
        <field name="name">aite.pos.daily.report.graph</field>
        <field name="model">aite.pos.daily.report</field>
        <field name="arch" type="xml">
            <graph string="Analyse POS" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="price_subtotal" type="measure"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pos_daily_report_list" model="ir.ui.view">
        <field name="name">aite.pos.daily.report.list</field>
        <field name="model">aite.pos.daily.report</field>
        <field name="arch" type="xml">
            <list string="Analyse POS" create="false" delete="false" edit="false">
                <field name="date" widget="date"/>
                <field name="config_id"/>
                <field name="product_id"/>
                <field name="categ_id" optional="show"/>
                <field name="famille_n1_id" optional="hide"/>
                <field name="famille_n2_id" optional="hide"/>
                <field name="qty" sum="Total qté"/>
                <field name="price_subtotal" sum="Total CA"/>
                <field name="total_cost" sum="Total CMV"/>
                <field name="margin" sum="Total marge"/>
                <field name="margin_rate" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!--
        NOTE ODOO 18 : les expressions Python dans les domaines de filtre
        (context_today(), relativedelta, strftime) ne sont plus évaluables
        côté client JS. On utilise à la place le filtre "date=" natif
        d'Odoo 18 qui génère automatiquement les périodes courantes
        (Aujourd'hui, Cette semaine, Ce mois, Ce trimestre, Cette année)
        via le framework, sans expression Python.
    -->
    <record id="view_pos_daily_report_search" model="ir.ui.view">
        <field name="name">aite.pos.daily.report.search</field>
        <field name="model">aite.pos.daily.report</field>
        <field name="arch" type="xml">
            <search string="Analyse POS">
                <field name="product_id"/>
                <field name="categ_id"/>
                <!-- Un seul champ « Famille » (REST-23-P1) : il cherche à
                     tous les niveaux ; le manager tape « Boissons » ou « Non
                     alcoolisé » sans savoir à quel niveau la famille se
                     trouve. Un nom tapé en entier ne ramène que cette famille
                     (« Alcoolisé » ne compte pas « Non alcoolisé ») ; une
                     famille choisie dans la liste est cherchée par son
                     identifiant (famille_id, méthode de recherche). -->
                <field name="famille_id" string="Famille"/>
                <field name="config_id"/>
                <field name="session_id"/>

                <!-- Filtre date natif Odoo 18 — génère les sous-périodes
                     automatiquement sans expression Python -->
                <filter string="Date" name="filter_date" date="date"/>

                <separator/>
                <group string="Regrouper par">
                    <filter string="Article" name="grp_product"
                            context="{'group_by':'product_id'}"/>
                    <filter string="Catégorie" name="grp_categ"
                            context="{'group_by':'categ_id'}"/>
                    <!-- Familles de caisse (REST-23-P1) : « Famille », puis
                         « Sous-famille », donnent au tableau croisé les
                         sous-totaux de chaque niveau. -->
                    <filter string="Famille" name="grp_famille"
                            context="{'group_by':'famille_n1_id'}"/>
                    <filter string="Sous-famille" name="grp_sous_famille"
                            context="{'group_by':'famille_n2_id'}"/>
                    <filter string="Sous-sous-famille" name="grp_sous_sous_famille"
                            context="{'group_by':'famille_n3_id'}"/>
                    <filter string="Point de vente" name="grp_config"
                            context="{'group_by':'config_id'}"/>
                    <filter string="Session" name="grp_session"
                            context="{'group_by':'session_id'}"/>
                    <filter string="Caissier" name="grp_user"
                            context="{'group_by':'user_id'}"/>
                    <filter string="Jour" name="grp_day"
                            context="{'group_by':'date:day'}"/>
                    <filter string="Semaine" name="grp_week"
                            context="{'group_by':'date:week'}"/>
                    <filter string="Mois" name="grp_month"
                            context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_daily_report" model="ir.actions.act_window">
        <field name="name">Analyse POS — Marge &amp; CMV</field>
        <field name="res_model">aite.pos.daily.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_pos_daily_report_search"/>
        <field name="context">{'group_by': ['categ_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune vente du Point de Vente sur ces filtres
            </p>
            <p>
                Chaque commande payée en caisse apparaît ici avec son chiffre
                d'affaires, son coût (CMV) et sa marge. Encaissez une vente
                dans une session de caisse, ou élargissez la période dans les
                filtres, puis regroupez par catégorie, caisse ou mois pour
                comparer.
            </p>
        </field>
    </record>

    <!-- Favori « Ventes par famille » (REST-23-P1 ; revue de 6a, constat 7) :
         le tableau croisé s'ouvre toujours par catégorie de produit (une base
         hôtelière garde son rapport) ; ce favori partagé donne, en deux
         touches (Favoris, « Ventes par famille »), les lignes Famille >
         Sous-famille et leurs sous-totaux. Posé une fois : le client peut le
         renommer ou le supprimer. -->
    <data noupdate="1">
        <record id="filtre_ventes_par_famille" model="ir.filters">
            <field name="name">Ventes par famille</field>
            <field name="model_id">aite.pos.daily.report</field>
            <field name="action_id" ref="action_pos_daily_report"/>
            <field name="user_id" eval="False"/>
            <field name="is_default" eval="False"/>
            <field name="domain">[]</field>
            <field name="context">{'group_by': ['famille_n1_id', 'famille_n2_id']}</field>
        </record>
    </data>

</odoo>
