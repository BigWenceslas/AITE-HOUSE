<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton flottant, ajouté à la mise en page commune du site
         (website.layout) : il figure donc sur toutes les pages — pages
         créées dans l'éditeur, boutique, blog, espace client, connexion,
         page 404 — y compris celles qui seront créées plus tard.

         Simple lien HTML, sans JavaScript : il fonctionne dès le
         chargement de la page.

         - Placé à la fin de #wrapwrap, sous l'en-tête (z-index 1029) :
           fenêtres modales, bannière des cookies, popups et menu mobile,
           qui vivent aussi dans #wrapwrap, passent au-dessus de lui ; il
           s'efface tant qu'une fenêtre modale est ouverte. Pas de classe
           « o_bottom_fixed_element » : dans #wrapwrap, Odoo compterait le
           bouton parmi les liens qu'il recouvre et le masquerait en bas de
           chaque page.
         - Visible pour les utilisateurs connectés, administrateurs compris :
           il ne dépend pas de « editable », qu'Odoo met à vrai pour tout
           concepteur du site, même hors édition. L'édition de la page le
           masque côté feuille de style (body.editor_enable).
         - Nom accessible : le texte d'accroche quand il y en a un (masqué
           visuellement sur mobile, mais toujours lu), suivi de « WhatsApp » ;
           « WhatsApp » seul sinon — un nom de marque, le même dans toutes
           les langues. -->
    <template id="whatsapp_button" name="AITE — Bouton WhatsApp" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-set="aite_wa_url" t-value="website and website.aite_whatsapp_enabled and website.aite_whatsapp_url"/>
            <a t-if="aite_wa_url"
               t-att-href="aite_wa_url"
               t-attf-class="o_aite_wa_button o_aite_wa_button_#{website.aite_whatsapp_position or 'right'}"
               target="_blank"
               rel="noopener noreferrer"
               title="WhatsApp">
                <span t-if="website.aite_whatsapp_label" class="o_aite_wa_label">
                    <t t-out="website.aite_whatsapp_label"/>
                    <span class="visually-hidden">(WhatsApp)</span>
                </span>
                <span t-else="" class="visually-hidden">WhatsApp</span>
                <span class="o_aite_wa_icon" aria-hidden="true">
                    <i class="fa fa-whatsapp"/>
                </span>
            </a>
        </xpath>
    </template>

</odoo>
