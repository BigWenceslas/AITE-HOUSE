<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton flottant, ajouté à la mise en page commune du site
         (website.layout) : il figure donc sur toutes les pages publiques —
         pages créées dans l'éditeur, boutique, blog, espace client,
         connexion — y compris celles qui seront créées plus tard.

         Simple lien HTML, sans JavaScript : il fonctionne dès le
         chargement de la page. Masqué dans l'éditeur et en mode
         traduction, pour ne pas gêner la mise en page. -->
    <template id="whatsapp_button" name="AITE — Bouton WhatsApp" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <t t-if="website and website.x_aite_wa_active and website.x_aite_wa_link and not editable and not translatable">
                <t t-set="aite_wa_message" t-value="website.x_aite_wa_message"/>
                <t t-set="aite_wa_label" t-value="website.x_aite_wa_label"/>
                <!-- quote_plus encode les espaces en « + » : on les rend en
                     « %20 », la forme que wa.me attend. Les « + » saisis
                     par l'utilisateur, eux, sont déjà encodés en « %2B ». -->
                <a t-att-href="website.x_aite_wa_link + ('?text=' + quote_plus(aite_wa_message).replace('+', '%20') if aite_wa_message else '')"
                   t-attf-class="o_aite_wa_button #{'o_aite_wa_button_left' if website.x_aite_wa_left else 'o_aite_wa_button_right'}"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Discuter avec nous sur WhatsApp"
                   aria-label="Discuter avec nous sur WhatsApp">
                    <span t-if="aite_wa_label" class="o_aite_wa_label" t-out="aite_wa_label"/>
                    <span class="o_aite_wa_icon" aria-hidden="true">
                        <i class="fa fa-whatsapp"/>
                    </span>
                </a>
            </t>
        </xpath>
    </template>

</odoo>
