<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Site web → Configuration → Paramètres : bloc « WhatsApp », placé
         juste après le bloc « Général » et réglé pour le site choisi en
         tête de l'écran. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aite.website.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="WhatsApp" id="aite_whatsapp_settings" invisible="not website_id">
                    <setting id="aite_whatsapp_button_setting"
                             string="Bouton WhatsApp"
                             help="Affiche sur toutes les pages du site un bouton qui ouvre directement une discussion WhatsApp avec vous.">
                        <field name="aite_whatsapp_enabled"/>
                        <div class="content-group" invisible="not aite_whatsapp_enabled">
                            <div class="row mt16">
                                <label for="aite_whatsapp_number" string="Numéro" class="col-lg-3 o_light_label"/>
                                <field name="aite_whatsapp_number"
                                       placeholder="+237 6 99 00 00 00"
                                       required="aite_whatsapp_enabled"/>
                            </div>
                            <div class="row">
                                <label for="aite_whatsapp_message" string="Message" class="col-lg-3 o_light_label"/>
                                <field name="aite_whatsapp_message"
                                       placeholder="Bonjour, je souhaite avoir des informations."/>
                            </div>
                            <div class="row">
                                <label for="aite_whatsapp_label" string="Accroche" class="col-lg-3 o_light_label"/>
                                <field name="aite_whatsapp_label"
                                       placeholder="Une question ? Écrivez-nous"/>
                            </div>
                            <div class="row">
                                <label for="aite_whatsapp_position" string="Position" class="col-lg-3 o_light_label"/>
                                <field name="aite_whatsapp_position" widget="radio"
                                       options="{'horizontal': true}"/>
                            </div>
                            <div class="mt8 text-muted small">
                                Numéro international, ou local s'il est du pays de la société.
                                Le message est pré-saisi pour le visiteur, qui peut le modifier avant l'envoi.
                            </div>
                            <div class="mt8" invisible="not aite_whatsapp_url">
                                <span class="o_form_label me-2">Tester :</span>
                                <field name="aite_whatsapp_url" widget="url" class="w-auto"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
