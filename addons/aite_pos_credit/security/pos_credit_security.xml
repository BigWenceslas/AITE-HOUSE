<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_pos_credit" model="ir.module.category">
            <field name="name">POS Crédit</field>
            <field name="description">Gestion des ardoises et du recouvrement POS</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_pos_credit_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_pos_credit"/>
            <field name="comment">Consulte les ardoises, enregistre des remboursements.</field>
        </record>

        <record id="group_pos_credit_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_pos_credit"/>
            <field name="implied_ids" eval="[(4, ref('group_pos_credit_user'))]"/>
            <field name="comment">Gère, annule, rouvre les ardoises ; accès au tableau de bord.</field>
        </record>

        <!-- ============ Règles multi-sociétés ============
             Sans ces règles, un utilisateur d'une société voyait les
             ardoises et les remboursements des autres sociétés du
             groupe — dans la liste, sur la fiche client (encours) et
             dans le tableau de bord du recouvrement. Même convention
             que le module hôtelier. -->
        <record id="rule_pos_credit_company" model="ir.rule">
            <field name="name">Ardoise : multi-sociétés</field>
            <field name="model_id" ref="model_aite_pos_credit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_pos_credit_payment_company" model="ir.rule">
            <field name="name">Remboursement d'ardoise : multi-sociétés</field>
            <field name="model_id" ref="model_aite_pos_credit_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
