<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_aite_credit" model="ir.ui.view">
        <field name="name">res.partner.form.aite.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ardoises" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="credit_ardoise_count == 0">
                    <field name="credit_ardoise_count" widget="statinfo"
                           string="Ardoises"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
