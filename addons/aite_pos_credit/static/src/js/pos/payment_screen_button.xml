<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Injecte le bouton « Mettre sur ardoise » dans la zone des boutons de
        l'écran de paiement (template PaymentScreenButtons, div.payment-buttons).
        C'est la cible correcte et stable en Odoo 18.0 (et non PaymentScreen /
        .paymentmethods, qui ne correspond pas).
    -->
    <t t-name="aite_pos_credit.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <!-- AH-02 : sur une caisse au service à table contrôlé
             (aite_pos_restaurant), le bouton n'apparaît que pour le manager
             et que si la caisse a un mode « ardoise ». Sur toute autre caisse
             (pos.aiteActif faux, ou absent sans aite_pos_restaurant : pas de
             dépendance), il reste affiché comme avant AH-02, et le toucher sans
             mode « ardoise » affiche l'aide à la configuration (décision
             d'arbitrage, incrément 4 du restaurant). -->
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <button t-if="!pos.aiteActif or (pos.aitePeut('ardoise') and _aiteGetCreditMethod())"
                    class="button btn btn-secondary btn-lg py-3 mb-2 w-100 aite-credit-btn"
                    t-on-click="() => this.putOnCredit()">
                <i class="fa fa-book me-2" role="img" aria-label="Ardoise"
                   title="Mettre sur ardoise"/>
                Mettre sur ardoise
            </button>
        </xpath>
    </t>

</templates>
