              name="Chambres"
              parent="menu_hotel_config_section"
              action="action_hotel_room"
              sequence="30"/>
    <menuitem id="menu_hotel_config_amenities"
              name="Aménités"
              parent="menu_hotel_config_section"
              action="action_hotel_amenity"
              sequence="40"/>
    <menuitem id="menu_hotel_config_services"
              name="Services hôteliers"
              parent="menu_hotel_config_section"
              action="action_hotel_service"
              sequence="50"/>
    <menuitem id="menu_hotel_config_seasons"
              name="Tarifs saisonniers"
              parent="menu_hotel_config_section"
              action="action_hotel_season_price"
              sequence="60"/>

</odoo>
