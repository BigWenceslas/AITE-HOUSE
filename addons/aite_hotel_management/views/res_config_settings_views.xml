<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_hotel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hotel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <app string="Gestion Hôtelière" name="aite_hotel_management"
                     groups="aite_hotel_management.group_hotel_manager">
                    <block title="Comptabilité des règlements"
                           name="hotel_accounting">
                        <setting id="hotel_auto_entries"
                                 help="Génère l'écriture débit trésorerie / crédit client (411) à chaque règlement de folio.">
                            <field name="hotel_auto_entries"/>
                        </setting>
                        <setting id="hotel_receivable_account"
                                 help="Compte client (411) crédité par les règlements ; à défaut, compte client du partenaire.">
                            <field name="hotel_receivable_account_id"/>
                        </setting>
                        <setting id="hotel_payment_journal"
                                 help="Journal de trésorerie des encaissements ; à défaut, caisse pour les espèces, banque sinon.">
                            <field name="hotel_payment_journal_id"/>
                        </setting>
                    </block>
                    <block title="Automatisations" name="hotel_automation">
                        <setting id="hotel_send_confirmation"
                                 help="Envoie automatiquement l'e-mail de confirmation au client dès la confirmation.">
                            <field name="hotel_send_confirmation"/>
                        </setting>
                        <setting id="hotel_auto_no_show"
                                 help="Bascule en no-show les réservations confirmées dont l'arrivée est dépassée du délai de grâce (cron quotidien).">
                            <field name="hotel_auto_no_show"/>
                            <div class="mt-2"
                                 invisible="not hotel_auto_no_show">
                                <field name="hotel_no_show_grace"
                                       class="o_light_label" style="width: 4rem;"/>
                                heures de grâce
                            </div>
                        </setting>
                        <setting id="hotel_auto_daily_hk"
                                 help="Crée chaque matin une tâche de ménage pour chaque chambre occupée.">
                            <field name="hotel_auto_daily_hk"/>
                        </setting>
                        <setting id="hotel_inspection_required"
                                 help="Après la recouche d'un départ, la chambre passe « à inspecter » avant d'être vendable comme propre.">
                            <field name="hotel_inspection_required"/>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>

</odoo>
