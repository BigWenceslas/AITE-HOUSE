<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hotel_payment_wizard_form" model="ir.ui.view">
        <field name="name">aite.hotel.payment.wizard.form</field>
        <field name="model">aite.hotel.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Encaisser un règlement">
                <group>
                    <group>
                        <field name="folio_id" readonly="1"/>
                        <field name="partner_id"/>
                        <field name="residual"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="is_deposit"/>
                        <field name="method"/>
                        <field name="transaction_ref"
                               required="method in ('mtn','orange')"
                               placeholder="ID transaction Mobile Money"/>
                        <field name="date"/>
                    </group>
                </group>
                <group>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Encaisser" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
