<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_hotel_reservation_confirmation" model="ir.actions.report">
        <field name="name">Confirmation de réservation</field>
        <field name="model">aite.hotel.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aite_hotel_management.report_reservation_document</field>
        <field name="report_file">aite_hotel_management.report_reservation_document</field>
        <field name="print_report_name">'Confirmation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_aite_hotel_reservation"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_hotel_folio" model="ir.actions.report">
        <field name="name">Note de séjour</field>
        <field name="model">aite.hotel.folio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aite_hotel_management.report_folio_document</field>
        <field name="report_file">aite_hotel_management.report_folio_document</field>
        <field name="print_report_name">'Note de sejour - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_aite_hotel_folio"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
