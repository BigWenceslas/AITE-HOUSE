<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie d'articles portant nuitées et services hôteliers -->
        <record id="product_category_hotel" model="product.category">
            <field name="name">Hébergement &amp; services hôteliers</field>
        </record>

        <!-- Aménités standards -->
        <record id="amenity_wifi" model="aite.hotel.amenity">
            <field name="name">Wi-Fi</field>
            <field name="icon">fa-wifi</field>
            <field name="sequence">10</field>
        </record>
        <record id="amenity_ac" model="aite.hotel.amenity">
            <field name="name">Climatisation</field>
            <field name="icon">fa-snowflake-o</field>
            <field name="sequence">20</field>
        </record>
        <record id="amenity_tv" model="aite.hotel.amenity">
            <field name="name">TV écran plat</field>
            <field name="icon">fa-television</field>
            <field name="sequence">30</field>
        </record>
        <record id="amenity_minibar" model="aite.hotel.amenity">
            <field name="name">Minibar</field>
            <field name="icon">fa-glass</field>
            <field name="sequence">40</field>
        </record>
        <record id="amenity_safe" model="aite.hotel.amenity">
            <field name="name">Coffre-fort</field>
            <field name="icon">fa-lock</field>
            <field name="sequence">50</field>
        </record>
        <record id="amenity_balcony" model="aite.hotel.amenity">
            <field name="name">Balcon</field>
            <field name="icon">fa-building-o</field>
            <field name="sequence">60</field>
        </record>
        <record id="amenity_breakfast" model="aite.hotel.amenity">
            <field name="name">Petit-déjeuner inclus</field>
            <field name="icon">fa-coffee</field>
            <field name="sequence">70</field>
        </record>

    </data>
</odoo>
