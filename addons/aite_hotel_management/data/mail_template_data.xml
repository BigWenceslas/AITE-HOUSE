<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_reservation_confirmation" model="mail.template">
            <field name="name">Hôtel : confirmation de réservation</field>
            <field name="model_id" ref="model_aite_hotel_reservation"/>
            <field name="subject">{{ object.hotel_id.name }} — Confirmation de réservation {{ object.name }}</field>
            <field name="email_from">{{ object.hotel_id.email or object.company_id.email or user.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif; font-size: 13px; color: #454748;">
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>
    <p>
        Nous avons le plaisir de confirmer votre réservation
        <strong t-out="object.name or ''"/> à
        <strong t-out="object.hotel_id.name or ''"/>.
    </p>
    <table style="border-collapse: collapse; margin: 12px 0;" cellpadding="6">
        <tr>
            <td style="border: 1px solid #ddd; background: #f5f5f4;"><strong>Arrivée</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="format_datetime(object.checkin_date, tz=user.tz, dt_format='EEEE d MMMM y, HH:mm', lang_code=object.partner_id.lang) or ''"/></td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; background: #f5f5f4;"><strong>Départ</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="format_datetime(object.checkout_date, tz=user.tz, dt_format='EEEE d MMMM y, HH:mm', lang_code=object.partner_id.lang) or ''"/></td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; background: #f5f5f4;"><strong>Nuits</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="object.nights or ''"/></td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; background: #f5f5f4;"><strong>Chambre(s)</strong></td>
            <td style="border: 1px solid #ddd;">
                <t t-foreach="object.line_ids" t-as="line">
                    <t t-out="line.room_id.name or ''"/> (<t t-out="line.room_type_id.name or ''"/>)<br/>
                </t>
            </td>
        </tr>
        <tr>
            <td style="border: 1px solid #ddd; background: #f5f5f4;"><strong>Total hébergement (HT)</strong></td>
            <td style="border: 1px solid #ddd;"><t t-out="format_amount(object.amount_room_total, object.currency_id) or ''"/></td>
        </tr>
    </table>
    <t t-if="object.hotel_id.note">
        <div style="border-top: 1px solid #ddd; margin-top: 10px; padding-top: 8px; font-size: 12px; color: #888780;">
            <t t-out="object.hotel_id.note"/>
        </div>
    </t>
    <p>
        Au plaisir de vous accueillir,<br/>
        <t t-out="object.hotel_id.name or ''"/>
        <t t-if="object.hotel_id.phone"> — <t t-out="object.hotel_id.phone"/></t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
