<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_hotel_reservation" model="ir.sequence">
            <field name="name">Réservation hôtel</field>
            <field name="code">aite.hotel.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="seq_hotel_folio" model="ir.sequence">
            <field name="name">Folio hôtel</field>
            <field name="code">aite.hotel.folio</field>
            <field name="prefix">FOL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="seq_hotel_housekeeping" model="ir.sequence">
            <field name="name">Tâche gouvernante</field>
            <field name="code">aite.hotel.housekeeping</field>
            <field name="prefix">HK/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

    </data>
</odoo>
