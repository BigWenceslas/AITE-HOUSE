<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_hotel" model="ir.module.category">
            <field name="name">Gestion Hôtelière</field>
            <field name="description">Réservations, folios, gouvernante et pilotage hôtelier</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_hotel_housekeeping" model="res.groups">
            <field name="name">Gouvernante</field>
            <field name="category_id" ref="module_category_hotel"/>
            <!-- Cocher un profil hôtel suffit : l'utilisateur devient interne. -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Gère les tâches de ménage et l'état des chambres ; consulte les séjours.</field>
        </record>

        <record id="group_hotel_user" model="res.groups">
            <field name="name">Réception</field>
            <field name="category_id" ref="module_category_hotel"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_housekeeping'))]"/>
            <field name="comment">Crée et suit les réservations, folios, encaissements ; check-in / check-out.</field>
        </record>

        <record id="group_hotel_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_hotel"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
            <field name="comment">Configure hôtels, chambres, tarifs ; annule, supprime, check-in anticipé.</field>
        </record>

        <!-- L'administrateur système reçoit le profil Responsable : le premier
             utilisateur voit l'application sans manipulation de droits. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_hotel_manager'))]"/>
        </record>

        <!-- ============ Règles multi-sociétés ============ -->
        <record id="rule_hotel_hotel_company" model="ir.rule">
            <field name="name">Hôtel : multi-sociétés</field>
            <field name="model_id" ref="model_aite_hotel_hotel"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hotel_reservation_company" model="ir.rule">
            <field name="name">Réservation hôtel : multi-sociétés</field>
            <field name="model_id" ref="model_aite_hotel_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hotel_folio_company" model="ir.rule">
            <field name="name">Folio hôtel : multi-sociétés</field>
            <field name="model_id" ref="model_aite_hotel_folio"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hotel_housekeeping_company" model="ir.rule">
            <field name="name">Gouvernante : multi-sociétés</field>
            <field name="model_id" ref="model_aite_hotel_housekeeping"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_hotel_room_company" model="ir.rule">
            <field name="name">Chambre : multi-sociétés</field>
            <field name="model_id" ref="model_aite_hotel_room"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
