<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_service_list" model="ir.ui.view">
        <field name="name">aite.booking.service.list</field>
        <field name="model">aite.booking.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="duration_minutes"/>
                <field name="price"/>
                <field name="product_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_booking_service" model="ir.actions.act_window">
        <field name="name">Prestations</field>
        <field name="res_model">aite.booking.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre catalogue de prestations</p>
            <p>Soins SPA, coupes homme / femme, pressing à la pièce —
            durée, prix et article lié (pour le folio et la facture).</p>
        </field>
    </record>
</odoo>
