<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Écart n° 61 : préfixe propre aux créneaux (« CRN/ »), distinct des
         séjours hôteliers (« RES/ »), et numérotation qui repart à 1 chaque
         année (plages de dates annuelles, année sur 4 chiffres comme les
         séjours). Les références déjà attribuées ne changent pas. -->
    <record id="seq_aite_slot_booking" model="ir.sequence">
        <field name="name">Réservation de créneau</field>
        <field name="code">aite.slot.booking</field>
        <field name="prefix">CRN/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
