<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hotel_reservation_form_registry" model="ir.ui.view">
        <field name="name">aite.hotel.reservation.form.registry</field>
        <field name="model">aite.hotel.reservation</field>
        <field name="inherit_id" ref="aite_hotel_management.view_hotel_reservation_form"/>
        <field name="arch" type="xml">

            <!-- Bouton intelligent : l'état du registre se lit d'un coup d'œil -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_registrations" type="object"
                        class="oe_stat_button" icon="fa-id-card-o"
                        invisible="state in ('draft', 'cancelled', 'no_show')">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="registration_done_count"/>/<field name="expected_guests"/>
                        </span>
                        <!-- Un seul nom pour la fiche : « fiche d'enregistrement » (loi
                             2016/006, imprimé) — et non « Fiches clients »
                             (relecture de l'intégration). -->
                        <span class="o_stat_text">Fiches d'enregistrement</span>
                    </div>
                </button>
            </xpath>

            <!-- Bandeau après check-in : quoi faire, en une phrase -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="status"
                     invisible="state != 'checked_in' or registration_status == 'done'">
                    <i class="fa fa-id-card-o me-2" title="Registre des clients"/>
                    <!-- Espace dans la balise : entre </b> et le champ, le blanc
                         seul est retiré par le moteur de gabarits, d'où
                         « clients :1 fiche(s) » (ECARTS n° 47). -->
                    <b>Registre des clients&#160;: </b>
                    <field name="registration_hint" readonly="1" nolabel="1" class="d-inline"/>
                    — <a type="object" name="action_open_registrations" class="alert-link">
                        compléter maintenant</a>
                </div>
                <div class="alert alert-success mb-0" role="status"
                     invisible="state != 'checked_in' or registration_status != 'done'">
                    <i class="fa fa-check-circle me-2" title="Registre à jour"/>
                    <b>Registre des clients à jour.</b>
                    <a type="object" name="action_print_registration_cards"
                       class="alert-link ms-2">Imprimer les fiches</a>
                </div>
            </xpath>

            <!-- Action d'impression dans l'en-tête -->
            <xpath expr="//header/button[@name='action_send_confirmation']" position="after">
                <button name="action_print_registration_cards" type="object"
                        string="Imprimer les fiches" icon="fa-print"
                        invisible="state not in ('confirmed', 'checked_in', 'checked_out')"/>
            </xpath>

            <xpath expr="//field[@name='state'][@widget='statusbar']" position="before">
                <field name="registration_status" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Liste des réservations : colonne registre -->
    <record id="view_hotel_reservation_list_registry" model="ir.ui.view">
        <field name="name">aite.hotel.reservation.list.registry</field>
        <field name="model">aite.hotel.reservation</field>
        <field name="inherit_id" ref="aite_hotel_management.view_hotel_reservation_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <!-- Rouge seulement pour un client arrivé : avant l'arrivée,
                     « Aucune fiche » est normal, le badge reste neutre
                     (ECARTS n° 54). -->
                <field name="registration_status" widget="badge" optional="show"
                       decoration-success="registration_status == 'done'"
                       decoration-warning="registration_status == 'partial'"
                       decoration-danger="registration_status == 'none' and state in ('checked_in', 'checked_out')"/>
            </xpath>
        </field>
    </record>

    <!-- Recherche : filtre « registre à compléter » -->
    <record id="view_hotel_reservation_search_registry" model="ir.ui.view">
        <field name="name">aite.hotel.reservation.search.registry</field>
        <field name="model">aite.hotel.reservation</field>
        <field name="inherit_id" ref="aite_hotel_management.view_hotel_reservation_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[1]" position="before">
                <filter name="registry_todo" string="Registre à compléter"
                        domain="[('state', '=', 'checked_in'), ('registration_status', '!=', 'done')]"/>
            </xpath>
        </field>
    </record>

</odoo>
