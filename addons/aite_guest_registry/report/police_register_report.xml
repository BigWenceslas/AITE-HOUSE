<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_police_register_wizard_form" model="ir.ui.view">
        <field name="name">aite.police.register.wizard.form</field>
        <field name="model">aite.police.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer le registre de police">
                <p class="text-muted">
                    Le registre liste, par ordre d'arrivée, toutes les
                    personnes hébergées sur la période — c'est le document
                    à présenter en cas de contrôle.
                </p>
                <group>
                    <field name="hotel_id" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="include_draft"/>
                    <field name="count"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimer"
                            class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_police_register_wizard" model="ir.actions.act_window">
        <field name="name">Registre de police</field>
        <field name="res_model">aite.police.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="paperformat_register_landscape" model="report.paperformat">
        <field name="name">Registre A4 paysage</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">22</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_police_register" model="ir.actions.report">
        <field name="name">Registre de police</field>
        <field name="model">aite.guest.registration</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aite_guest_registry.report_police_register_document</field>
        <field name="report_file">aite_guest_registry.report_police_register_document</field>
        <field name="print_report_name">'Registre de police'</field>
        <field name="paperformat_id" ref="aite_guest_registry.paperformat_register_landscape"/>
    </record>

    <template id="report_police_register_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size:10px">
                    <h2 class="mb-0">REGISTRE DES CLIENTS HÉBERGÉS</h2>
                    <!-- Le client web renvoie les dates du contexte en chaînes
                         (JSON) : on les relit depuis leur forme ISO, qu'elles
                         arrivent en chaîne ou en date (ECARTS n° 16). -->
                    <t t-set="period_from" t-value="env.context.get('date_from') and datetime.date.fromisoformat(str(env.context['date_from'])[:10])"/>
                    <t t-set="period_to" t-value="env.context.get('date_to') and datetime.date.fromisoformat(str(env.context['date_to'])[:10])"/>
                    <div class="text-muted mb-2">
                        <span t-esc="env.context.get('hotel_name') or (docs and docs[0].hotel_id.name) or ''"/>
                        — du <span t-esc="period_from and period_from.strftime('%d/%m/%Y')"/> au <span t-esc="period_to and period_to.strftime('%d/%m/%Y')"/>
                        — <t t-esc="len(docs)"/> personne(s)
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead class="bg-light">
                            <tr>
                                <th>Arrivée</th><th>Départ</th><th>Ch.</th>
                                <th>Nom</th><th>Prénom(s)</th><th>Né(e) le</th>
                                <th>Nationalité</th><th>Pièce</th><th>N°</th>
                                <th>Provenance</th><th>Destination</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="g">
                                <td><span t-field="g.arrival_date"/></td>
                                <td><span t-field="g.departure_date"/></td>
                                <td><span t-field="g.room_id.name"/></td>
                                <td class="text-uppercase"><span t-field="g.last_name"/></td>
                                <td><span t-field="g.first_name"/></td>
                                <td><span t-field="g.birth_date"/></td>
                                <td><span t-field="g.nationality_id.name"/></td>
                                <td><span t-field="g.id_type"/></td>
                                <td><span t-field="g.id_number"/></td>
                                <td><span t-field="g.coming_from"/></td>
                                <td><span t-field="g.going_to"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="row mt-4">
                        <div class="col-6">Arrêté le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></div>
                        <div class="col-6 text-end">Cachet et signature de l'établissement</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
