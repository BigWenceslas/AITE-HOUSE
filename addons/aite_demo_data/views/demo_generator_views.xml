<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_demo_generate_wizard_form" model="ir.ui.view">
        <field name="name">aite.demo.generate.wizard.form</field>
        <field name="model">aite.demo.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Jeu d'essai AITE">
                <div class="alert alert-warning" role="alert">
                    <strong>Base de démonstration uniquement.</strong>
                    Cet assistant crée des ardoises, achats, tâches de
                    gouvernante et profils utilisateurs fictifs.
                </div>
                <group>
                    <field name="scale"/>
                    <field name="purge_first"/>
                </group>
                <group string="Résultat" invisible="not result">
                    <field name="result" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Générer" class="btn-primary"/>
                    <button name="action_purge" type="object"
                            string="Purger seulement" class="btn-secondary"/>
                    <button special="cancel" string="Fermer"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_demo_generate_wizard" model="ir.actions.act_window">
        <field name="name">Jeu d'essai AITE</field>
        <field name="res_model">aite.demo.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_demo_generate"
              name="Jeu d'essai AITE"
              parent="base.menu_administration"
              action="action_demo_generate_wizard"
              groups="base.group_system"
              sequence="90"/>

</odoo>
