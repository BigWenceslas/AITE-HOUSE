<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="hotel_main" model="aite.hotel.hotel">
            <field name="name">Complexe Hôtelier — Démo</field>
            <field name="code">CPX</field>
        </record>
        <record id="floor_rdc" model="aite.hotel.floor">
            <field name="name">Rez-de-chaussée</field>
            <field name="hotel_id" ref="hotel_main"/>
            <field name="sequence" eval="1"/>
        </record>
        <record id="floor_1" model="aite.hotel.floor">
            <field name="name">1er étage</field>
            <field name="hotel_id" ref="hotel_main"/>
            <field name="sequence" eval="2"/>
        </record>
        <record id="floor_2" model="aite.hotel.floor">
            <field name="name">2e étage</field>
            <field name="hotel_id" ref="hotel_main"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="cat_hebergement" model="product.category">
            <field name="name">Hébergement</field>
        </record>
        <record id="prod_nuitee" model="product.product">
            <field name="name">Nuitée</field>
            <field name="type">service</field>
            <field name="categ_id" ref="cat_hebergement"/>
            <field name="sale_ok" eval="True"/>
            <field name="list_price" eval="0.0"/>
        </record>
        <record id="prod_pdej" model="product.product">
            <field name="name">Petit-déjeuner</field>
            <field name="type">service</field>
            <field name="categ_id" ref="cat_hebergement"/>
            <field name="sale_ok" eval="True"/>
            <field name="list_price" eval="25000"/>
        </record>
        <record id="rtype_std" model="aite.hotel.room.type">
            <field name="name">Standard</field>
            <field name="code">STD</field>
            <field name="base_price" eval="450000"/>
            <field name="capacity_adults" eval="2"/>
            <field name="capacity_children" eval="1"/>
        </record>
        <record id="rtype_cft" model="aite.hotel.room.type">
