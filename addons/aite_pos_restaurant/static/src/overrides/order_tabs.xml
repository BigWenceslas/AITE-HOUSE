<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Le « + » n'apparaît en mode que si la case « Autoriser la vente sans
         table » est cochée (PROF-04-P1). Hors mode, le bouton d'Odoo reste. -->
    <t t-name="aite_pos_restaurant.OrderTabs" t-inherit="point_of_sale.OrderTabs" t-inherit-mode="extension">
        <xpath expr="//ListContainer" position="attributes">
            <attribute name="onClickPlus">pos.aiteActif and !pos.config.aite_vente_sans_table ? undefined : () => this.newFloatingOrder()</attribute>
        </xpath>
    </t>

</templates>
