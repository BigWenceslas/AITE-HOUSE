<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Pas de « + » en mode (pas de vente sans table, R17). Hors mode, le
         bouton d'Odoo reste. -->
    <t t-name="aite_pos_restaurant.OrderTabs" t-inherit="point_of_sale.OrderTabs" t-inherit-mode="extension">
        <xpath expr="//ListContainer" position="attributes">
            <attribute name="onClickPlus">pos.aiteActif ? undefined : () => this.newFloatingOrder()</attribute>
        </xpath>
    </t>

</templates>
