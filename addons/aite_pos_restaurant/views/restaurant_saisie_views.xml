<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Le journal des saisies (spécification, parties 3.2 et 5.1 ;
         incrément 3). Pas de menu : il s'ouvre par le bouton « Saisies » de
         la fiche de l'addition, filtré sur elle. Lecture seule (create,
         edit, delete à 0) : le serveur seul l'écrit. -->
    <record id="view_restaurant_saisie_list" model="ir.ui.view">
        <field name="name">aite.restaurant.saisie.list</field>
        <field name="model">aite.restaurant.saisie</field>
        <field name="arch" type="xml">
            <list string="Saisies" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="table_nom"/>
                <field name="produit_nom"/>
                <field name="quantite" sum="Total"/>
                <field name="employe_nom"/>
                <field name="order_ref" optional="hide"/>
                <field name="config_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_saisie_search" model="ir.ui.view">
        <field name="name">aite.restaurant.saisie.search</field>
        <field name="model">aite.restaurant.saisie</field>
        <field name="arch" type="xml">
            <search string="Saisies">
                <field name="produit_nom"/>
                <field name="employe_nom"/>
                <field name="table_nom"/>
                <field name="order_ref"/>
                <filter name="date" date="date" string="Date"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_employe" string="Saisie par" context="{'group_by': 'employe_nom'}"/>
                    <filter name="par_produit" string="Produit" context="{'group_by': 'produit_nom'}"/>
                    <filter name="par_table" string="Table" context="{'group_by': 'table_nom'}"/>
                    <filter name="par_jour" string="Jour" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_restaurant_saisie" model="ir.actions.act_window">
        <field name="name">Saisies</field>
        <field name="res_model">aite.restaurant.saisie</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_restaurant_saisie_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune saisie pour cette addition. Chaque fois qu'un employé ajoute un produit ou augmente une quantité, la caisse l'écrit ici, à son nom et à l'heure exacte, dès que l'addition est enregistrée.
            </p>
        </field>
    </record>

</odoo>
