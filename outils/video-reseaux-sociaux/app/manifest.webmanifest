{
  "name": "Prêt à poster",
  "short_name": "Prêt à poster",
  "description": "Convertit les vidéos du Pixel pour WhatsApp, TikTok et Facebook, directement sur le téléphone.",
  "lang": "fr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f1",
  "theme_color": "#0f6b5c",
  "icons": [
    { "src": "icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icone.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "video", "accept": ["video/*", ".mp4", ".mov"] }]
    }
  }
}
